function loadAvailablePeriods() {
    const selectPeriod = document.getElementById('selectPeriod');
    selectPeriod.innerHTML = '<option value="">-- Choisir une période --</option>';
    
    if (allRecords.length === 0) {
        selectPeriod.innerHTML += '<option value="" disabled>Aucun enregistrement disponible</option>';
        return;
    }
    
    
    const periods = new Set();
    
    allRecords.forEach(record => {
        const date = new Date(record.startDate);
        const monthYear = `${date.getMonth() + 1}/${date.getFullYear()}`;
        periods.add(monthYear);
        
         
        periods.add(`Année ${date.getFullYear()}`);
    });
    
     
    periods.forEach(period => {
        const option = document.createElement('option');
        option.value = period;
        option.textContent = period;
        selectPeriod.appendChild(option);
    });
    
     
    const allOption = document.createElement('option');
    allOption.value = 'all';
    allOption.textContent = 'Toutes les périodes disponibles';
    selectPeriod.appendChild(allOption);
}
      
      
         
