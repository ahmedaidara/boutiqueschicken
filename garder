function createSimpleChart(type, data, labels, colors, title) {
    try {
        const canvas = document.createElement('canvas');
        canvas.width = 600;
        canvas.height = 400;
        const ctx = canvas.getContext('2d');
        
         
        if (typeof Chart === 'undefined') {
            console.error("Chart.js n'est pas chargé");
            return null;
        }
        
        return new Promise((resolve) => {
             
            setTimeout(() => {
                try {
                    new Chart(ctx, {
                        type: type,
                        data: {
                            labels: labels,
                            datasets: [{
                                data: data,
                                backgroundColor: colors,
                                borderColor: colors.map(c => c.replace('0.8', '1')),
                                borderWidth: 2
                            }]
                        },
                        options: {
                            responsive: false,
                            plugins: {
                                title: {
                                    display: true,
                                    text: title,
                                    font: { size: 14, weight: 'bold' }
                                },
                                legend: {
                                    display: type !== 'bar'
                                }
                            }
                        }
                    });
                    
                     
                    setTimeout(() => {
                        resolve(canvas);
                    }, 100);
                    
                } catch (error) {
                    console.error("Erreur création graphique:", error);
                    resolve(null);
                }
            }, 50);
        });
        
    } catch (error) {
        console.error("Erreur création canvas:", error);
        return Promise.resolve(null);
    }
}

 
