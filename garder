                                showMessage('Dépenses chargées pour modification', 'success');
                            }, 500);
                            
                            break;
                        }
                    }
                    
                });
            
        }).catch(error => {
            console.error('Erreur:', error);
            showMessage('Erreur de chargement', 'error');
        });
}

 
