function analyzeStockEvolution(records) {
    const analysis = [];
    
    records.forEach(record => {
        const initialStock = record.initialStock || 0;
        const growthRate = record.growthRate || 0;
        const adjustedStock = initialStock * (1 + growthRate/100);
        const avgPrice = ((record.small1Price || 0) + (record.small2Price || 0) + 
                  (record.medium1Price || 0) + (record.medium2Price || 0) + 
                  (record.large1Price || 0) + (record.large2Price || 0) + 
                  (record.xlarge1Price || 0) + (record.xlarge2Price || 0)) / 8;
        const estimatedValue = adjustedStock * avgPrice;
        
        analysis.push({
            period: formatDate(record.startDate),
            initialStock,
            growthRate,
            adjustedStock,
            estimatedValue
        });
    });
    
    return analysis;
}

function calculateGrowthStats(records) {
    let totalGrowth = 0;
    let totalLoss = 0;
    let count = 0;
    
    records.forEach(record => {
        if (record.growthRate !== undefined) {
            totalGrowth += record.growthRate || 0;
            totalLoss += record.lossRate || 0;
            count++;
        }
    });
    
    return {
        avgGrowthRate: count > 0 ? totalGrowth / count : 0,
        avgLossRate: count > 0 ? totalLoss / count : 0,
        netImpact: count > 0 ? (totalGrowth - totalLoss) / count : 0
    };
}

