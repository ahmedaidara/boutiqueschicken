        includeTimestamp: document.getElementById('includeTimestamp').checked,
        includeFooter: document.getElementById('includeFooter').checked,
        colorPrint: document.getElementById('colorPrint').checked,
        orientation: document.getElementById('orientation').value
    };
    
     
    let periodType = 'all';
    let startDate = null;
    let endDate = null;
    let periodName = 'Tous les enregistrements';
    
     
    if (document.getElementById('periodMonth').checked) {
        periodType = 'month';
        periodName = '30 derniers jours';
        endDate = new Date();
        startDate = new Date();
        startDate.setDate(startDate.getDate() - 30);
    } else if (document.getElementById('periodWeek').checked) {
        periodType = 'week';
        periodName = '7 derniers jours';
        endDate = new Date();
        startDate = new Date();
        startDate.setDate(startDate.getDate() - 7);
    } else if (document.getElementById('periodCustom').checked) {
        periodType = 'custom';
        
         
        const selectedPeriod = document.getElementById('selectPeriod').value;
        const customStart = document.getElementById('customStartDate').value;
        const customEnd = document.getElementById('customEndDate').value;
        
        if (selectedPeriod && selectedPeriod !== '') {
            periodName = `Période: ${selectedPeriod}`;
            
            
            if (selectedPeriod === 'all') {
                 
                periodName = 'Toutes les périodes disponibles';
            } else if (selectedPeriod.startsWith('Année ')) {
                 
                const year = parseInt(selectedPeriod.replace('Année ', ''));
                startDate = new Date(year, 0, 1);
                endDate = new Date(year, 11, 31);
            } else {
                // Mois/Année  
                const [month, year] = selectedPeriod.split('/').map(Number);
                startDate = new Date(year, month - 1, 1);
                endDate = new Date(year, month, 0);  
            }
        } else if (customStart && customEnd) {
            // Période personnalisée  
            startDate = new Date(customStart);
            endDate = new Date(customEnd);
            periodName = `Période du ${formatDate(customStart)} au ${formatDate(customEnd)}`;
        } else {
            showMessage('Veuillez sélectionner ou spécifier une période personnalisée', 'error');
            return;
        }
    }
    
    // Filtrer les   période
    let recordsForPDF = [];
    
    if (periodType === 'all') {
        recordsForPDF = [...allRecords];
    } else if (startDate && endDate) {
        recordsForPDF = allRecords.filter(record => {
            const recordDate = new Date(record.startDate);
            return recordDate >= startDate && recordDate <= endDate;
        });
    } else {
        recordsForPDF = [...allRecords];
    }
    
    if (recordsForPDF.length === 0) {
        showMessage('Aucun enregistrement trouvé pour la période sélectionnée', 'error');
        return;
    }
    
    // Génér  PDF
    await generatePDFDocument(recordsForPDF, options, periodName);

}

