// Charger les détails de la production sélectionnée
function loadProductionDetailsForExpenses() {
    if (!currentProductionForExpenses) return;
    
    const production = currentProductionForExpenses.data;
    const date = new Date(production.startDate);
    const dateStr = `${date.getDate()}/${date.getMonth()+1}/${date.getFullYear()}`;
    
    // Afficher les infos
    document.getElementById('productionInfoExpenses').innerHTML = `
        <strong>Production du ${dateStr}</strong><br>
        Stock initial: ${production.initialStock || 0} poulets<br>
        Dates: ${formatDate(production.startDate)} ${production.endDate ? ' - ' + formatDate(production.endDate) : ''}
    `;
    
    // Calculer le CA initial (valeur estimée des ventes)
    const revenue = calculateProductionRevenue(production);
    
    // Afficher la section CA
    document.getElementById('revenueSection').style.display = 'block';
    document.getElementById('productionRevenue').value = revenue;
    
    // Afficher le tableau des dépenses
    document.getElementById('expensesTableSection').style.display = 'block';
    
    // Initialiser le tableau avec une ligne vide
    expensesData = [];
    addExpenseRow();
}

// Calculer le revenu de la production
function calculateProductionRevenue(production) {
    // Ventes par catégorie × prix
    const revenue = (production.small1Sold || 0) * (production.small1Price || 0) +
                   (production.small2Sold || 0) * (production.small2Price || 0) +
                   (production.medium1Sold || 0) * (production.medium1Price || 0) +
                   (production.medium2Sold || 0) * (production.medium2Price || 0) +
                   (production.large1Sold || 0) * (production.large1Price || 0) +
                   (production.large2Sold || 0) * (production.large2Price || 0) +
                   (production.xlarge1Sold || 0) * (production.xlarge1Price || 0) +
                   (production.xlarge2Sold || 0) * (production.xlarge2Price || 0);
    
    return revenue;
}

