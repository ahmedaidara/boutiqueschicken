        function updateAccessCode() {
            const newCode = document.getElementById('newCode').value;
            const confirmCode = document.getElementById('confirmCode').value;
            
             
            if (!newCode || !confirmCode) {
                showMessage('Veuillez remplir les deux champs', 'error');
                return;
            }
            
            if (newCode.length < 4 || newCode.length > 8) {
                showMessage('Le code doit contenir entre 4 et 8 chiffres', 'error');
                return;
            }
            
            if (!/^\d+$/.test(newCode)) {
                showMessage('Le code ne doit contenir que des chiffres', 'error');
                return;
            }
            
            if (newCode !== confirmCode) {
                showMessage('Les codes ne correspondent pas', 'error');
                return;
            }
            
             
            db.collection('poulailler_settings').doc('access_code').set({
                code: newCode,
                updatedAt: firebase.firestore.FieldValue.serverTimestamp()
            })
            .then(() => {
                showMessage('Code mis à jour avec succès!', 'success');
                document.getElementById('newCode').value = '';
                document.getElementById('confirmCode').value = '';
            })
            .catch(error => {
                console.error("Erreur de mise à jour du code:", error);
                showMessage("Erreur lors de la mise à jour du code", 'error');
