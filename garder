                        record.startDate.includes(searchTerm) ||
                        (record.endDate && record.endDate.includes(searchTerm)) ||
                        (record.notes && record.notes.toLowerCase().includes(searchTerm))
                    );
                });
            }
            
             
            updateRecordsTable();
