function getNotesFromRecords(records) {
    const notes = [];
    
    records.forEach(record => {
        if (record.notes && record.notes.trim() !== '') {
            notes.push({
                date: formatDate(record.startDate),
                text: record.notes
            });
        }
    });
    
    return notes;
}

function getLossAndGivenData(records) {
    let totalLost = 0;
    let totalGiven = 0;
    let estimatedLoss = 0;
    
    records.forEach(record => {
        totalLost += record.lost || 0;
        totalGiven += record.given || 0;
        
         
        const avgPrice = ((record.smallPrice || 0) + (record.mediumPrice || 0) + (record.largePrice || 0)) / 3;
        estimatedLoss += (record.lost || 0) * avgPrice;
    });
    
    return {
        totalLost,
        totalGiven,
        estimatedLoss
    };
}
        
         
