                return;
            }
            
            snapshot.forEach(doc => {
                const data = doc.data();
                const productionDate = new Date(data.productionDate);
                const dateStr = formatDate(productionDate);
                
                // Récupérer les infos de la production
                let stockInitial = 'N/A';
                
                db.collection('poulailler_records').doc(data.productionId).get()
                    .then(prodDoc => {
                        if (prodDoc.exists) {
                            const prodData = prodDoc.data();
                            stockInitial = prodData.initialStock || 0;
                            
                            // Mettre à jour l'affichage
                            const stockCell = document.getElementById(`stock-${doc.id}`);
                            if (stockCell) stockCell.textContent = stockInitial;
                        }
                    });
                
                const netProfit = data.netProfit || 0;
                const profitColor = netProfit > 0 ? '#059669' : '#dc2626';
                const profitBg = netProfit > 0 ? '#f0fdf4' : '#fef2f2';
                
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${dateStr}</td>
                    <td id="stock-${doc.id}">Chargement...</td>
                    <td style="font-weight: bold; color: #dc2626;">${(data.totalExpenses || 0).toLocaleString('fr-FR')} F CFA</td>
                    <td style="font-weight: bold; color: #3b82f6;">${(data.revenue || 0).toLocaleString('fr-FR')} F CFA</td>
                    <td style="background: ${profitBg}; color: ${profitColor}; font-weight: bold;">
                        ${netProfit.toLocaleString('fr-FR')} F CFA
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="action-btn-small view" onclick="viewExpenseDetails('${doc.id}')" title="Voir">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="action-btn-small edit" onclick="editExpense('${doc.id}')" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="action-btn-small delete" onclick="deleteExpense('${doc.id}')" title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                
                tbody.appendChild(row);
            });
            
        }).catch(error => {
            console.error('Erreur chargement liste:', error);
        });
}

// Voir les détails d'une dépense
function viewExpenseDetails(expenseId) {
    db.collection('production_expenses').doc(expenseId).get()
        .then(doc => {
            if (!doc.exists) return;
            
            const data = doc.data();
            
            let content = `
                <div style="max-width: 800px;">
                    <h3 style="margin-bottom: 20px; color: var(--dark-text);">
                        <i class="fas fa-file-invoice-dollar"></i> Détails des Dépenses
                    </h3>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
                        <div style="background: #f0f9ff; padding: 15px; border-radius: 10px;">
                            <h4 style="margin-bottom: 10px; color: #0369a1;">Chiffre d'Affaires</h4>
                            <div style="font-size: 1.5rem; font-weight: bold; color: #3b82f6;">
                                ${(data.revenue || 0).toLocaleString('fr-FR')} F CFA
                            </div>
                        </div>
                        
                        <div style="background: #fef2f2; padding: 15px; border-radius: 10px;">
                            <h4 style="margin-bottom: 10px; color: #dc2626;">Total Dépenses</h4>
                            <div style="font-size: 1.5rem; font-weight: bold; color: #dc2626;">
                                ${(data.totalExpenses || 0).toLocaleString('fr-FR')} F CFA
                            </div>
                        </div>
                    </div>
                    
                    <div style="background: ${data.netProfit > 0 ? '#f0fdf4' : '#fef2f2'}; 
                         padding: 20px; border-radius: 10px; margin-bottom: 30px; text-align: center;">
                        <h4 style="margin-bottom: 10px; color: ${data.netProfit > 0 ? '#059669' : '#dc2626'};">Bénéfice Net</h4>
                        <div style="font-size: 2rem; font-weight: bold; color: ${data.netProfit > 0 ? '#059669' : '#dc2626'};">
                            ${(data.netProfit || 0).toLocaleString('fr-FR')} F CFA
                        </div>
                    </div>
                    
                    <h4 style="margin-bottom: 15px;">Détail des Dépenses</h4>
            `;
            
            if (data.expenses && data.expenses.length > 0) {
                content += `
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                        <thead>
                            <tr style="background: var(--light-gray);">
                                <th style="padding: 10px; text-align: left;">Nom</th>
                                <th style="padding: 10px; text-align: left;">Description</th>
                                <th style="padding: 10px; text-align: center;">Quantité</th>
                                <th style="padding: 10px; text-align: right;">Prix Unitaire</th>
                                <th style="padding: 10px; text-align: right;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                `;
                
                data.expenses.forEach(expense => {
                    content += `
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 10px;">${expense.name || ''}</td>
                            <td style="padding: 10px;">${expense.description || ''}</td>
                            <td style="padding: 10px; text-align: center;">${expense.quantity || 0}</td>
                            <td style="padding: 10px; text-align: right;">${(expense.unitPrice || 0).toLocaleString('fr-FR')} F CFA</td>
                            <td style="padding: 10px; text-align: right; font-weight: bold;">
                                ${(expense.total || 0).toLocaleString('fr-FR')} F CFA
                            </td>
                        </tr>
                    `;
                });
                
                content += `</tbody></table>`;
            } else {
                content += `<p style="text-align: center; color: var(--gray-text);">Aucun détail de dépense</p>`;
            }
            
            content += `</div>`;
            
            // Afficher dans une modal
            const modal = document.createElement('div');
            modal.id = 'expenseDetailsModal';
            modal.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 1000;
                padding: 20px;
            `;
            
            modal.innerHTML = `
                <div style="background: white; border-radius: 15px; padding: 30px; width: 100%; max-width: 900px; max-height: 80vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <h3 style="margin: 0; color: var(--dark-text);">Détails des Dépenses</h3>
                        <button onclick="document.getElementById('expenseDetailsModal').remove()"
                                style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-text);">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    ${content}
                    <div style="margin-top: 20px; text-align: center;">
                        <button onclick="printExpenseDetails('${doc.id}')" 
                                style="background: var(--primary); color: white; border: none; padding: 10px 30px; border-radius: 8px; cursor: pointer; margin-right: 10px;">
                            <i class="fas fa-print"></i> Imprimer
                        </button>
                        <button onclick="document.getElementById('expenseDetailsModal').remove()"
                                style="background: var(--light-gray); color: var(--dark-text); border: none; padding: 10px 30px; border-radius: 8px; cursor: pointer;">
                            Fermer
                        </button>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            
        }).catch(error => {
            console.error('Erreur:', error);
            showMessage('Erreur de chargement', 'error');
        });
}

// Modifier une dépense existante
function editExpense(expenseId) {
    db.collection('production_expenses').doc(expenseId).get()
        .then(doc => {
            if (!doc.exists) return;
            
            const data = doc.data();
            
            // Charger la production correspondante
            db.collection('poulailler_records').doc(data.productionId).get()
                .then(prodDoc => {
                    if (!prodDoc.exists) return;
                    
                    const prodData = prodDoc.data();
                    
                    // Sélectionner cette production dans la liste
                    const select = document.getElementById('selectProductionExpenses');
                    for (let i = 0; i < select.options.length; i++) {
                        if (select.options[i].value === data.productionId) {
                            select.selectedIndex = i;
                            
                            // Déclencher l'événement change
                            const event = new Event('change');
                            select.dispatchEvent(event);
                            
                            // Remplir les données après un court délai
                            setTimeout(() => {
                                document.getElementById('productionRevenue').value = data.revenue || 0;
                                
                                // Vider et remplir les dépenses
                                expensesData = [];
                                document.getElementById('expensesTableBody').innerHTML = '';
                                
                                if (data.expenses && Array.isArray(data.expenses)) {
                                    data.expenses.forEach(expense => {
                                        addExpenseRow();
                                        
                                        // Remplir la dernière ligne ajoutée
                                        const lastRow = document.querySelector('#expensesTableBody tr:last-child');
                                        if (lastRow) {
                                            lastRow.querySelector('.expense-name').value = expense.name || '';
                                            lastRow.querySelector('.expense-description').value = expense.description || '';
                                            lastRow.querySelector('.expense-quantity').value = expense.quantity || 0;
