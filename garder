// Mettre à jour une ligne de dépense
function updateExpenseRow(rowId) {
    const row = document.getElementById(`expenseRow-${rowId}`);
    const index = expensesData.findIndex(exp => exp.id == rowId);
    
    if (index === -1) return;
    
    // Récupérer les valeurs
    const name = row.querySelector('.expense-name').value;
    const description = row.querySelector('.expense-description').value;
    const quantity = parseInt(row.querySelector('.expense-quantity').value) || 0;
    const unitPrice = parseInt(row.querySelector('.expense-unit-price').value) || 0;
    const total = quantity * unitPrice;
    
    // Mettre à jour les données
    expensesData[index] = {
        ...expensesData[index],
        name,
        description,
        quantity,
        unitPrice,
        total
    };
    
    // Mettre à jour l'affichage du total
    row.querySelector('.expense-total').textContent = `${total.toLocaleString('fr-FR')} F CFA`;
    
    // Calculer les totaux
    calculateExpensesTotals();
}

// Supprimer une ligne de dépense
function removeExpenseRow(rowId) {
    // Supprimer de l'interface
    const row = document.getElementById(`expenseRow-${rowId}`);
    if (row) row.remove();
    
    // Supprimer des données
    expensesData = expensesData.filter(exp => exp.id != rowId);
    
    // Calculer les totaux
    calculateExpensesTotals();
}

// Calculer les totaux des dépenses
function calculateExpensesTotals() {
    let totalQuantity = 0;
    let totalAmount = 0;
    
    expensesData.forEach(expense => {
        totalQuantity += expense.quantity || 0;
        totalAmount += expense.total || 0;
    });
    
    // Mettre à jour l'affichage
    document.getElementById('totalQuantity').textContent = totalQuantity;
    document.getElementById('totalExpensesAmount').textContent = `${totalAmount.toLocaleString('fr-FR')} F CFA`;
    document.getElementById('totalExpensesDisplay').textContent = `${totalAmount.toLocaleString('fr-FR')} F CFA`;
    
    // Calculer le bénéfice net
    calculateNetProfit();
}

// Calculer le bénéfice net
function calculateNetProfit() {
    const revenue = parseInt(document.getElementById('productionRevenue').value) || 0;
    const totalExpenses = expensesData.reduce((sum, exp) => sum + (exp.total || 0), 0);
    const netProfit = revenue - totalExpenses;
    
    // Mettre à jour l'affichage
    document.getElementById('netProfitDisplay').textContent = `${netProfit.toLocaleString('fr-FR')} F CFA`;
    
    // Changer la couleur selon le résultat
    const netProfitDisplay = document.getElementById('netProfitDisplay');
    if (netProfit > 0) {
        netProfitDisplay.style.background = '#f0fdf4';
        netProfitDisplay.style.color = '#059669';
    } else if (netProfit < 0) {
        netProfitDisplay.style.background = '#fef2f2';
        netProfitDisplay.style.color = '#dc2626';
    } else {
        netProfitDisplay.style.background = '#f8fafc';
        netProfitDisplay.style.color = '#475569';
    }
    
    // Afficher/masquer le bouton imprimer
    document.getElementById('printExpensesBtn').style.display = 
        (revenue > 0 || totalExpenses > 0) ? 'inline-block' : 'none';
}

