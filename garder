function calculateStatisticsForPDF(records) {
    // CALCULER EXACTEMENT COMME LE TABLEAU DE BORD
    let totalProduction = 0;   // Stock total restant
    let totalStock = 0;        // Stock initial total
    let totalValue = 0;        // Valeur du stock restant
    let totalRevenue = 0;      // Chiffre d'affaires total
    
    records.forEach(record => {
        // 1. Calcul du STOCK RESTANT (comme dans updateStatistics())
        const initialStock = record.initialStock || 0;
        
        // TOTAL VENDUS (8 catégories)
        const totalSold = (record.small1Sold || 0) + (record.small2Sold || 0) + 
                         (record.medium1Sold || 0) + (record.medium2Sold || 0) + 
                         (record.large1Sold || 0) + (record.large2Sold || 0) + 
                         (record.xlarge1Sold || 0) + (record.xlarge2Sold || 0);
        
        const totalLostGiven = (record.lost || 0) + (record.given || 0);
        
        // Stock restant = initial - vendus - perdus/donnés
        const stockRestant = Math.max(0, initialStock - totalSold - totalLostGiven);
        
        // 2. Stock total restant
        totalProduction += stockRestant;
        
        // 3. Stock initial total
        totalStock += initialStock;
        
        // 4. VALEUR du stock restant (calcul EXACT comme tableau de bord)
        // Calculer la valeur des poulets RESTANTS (non vendus)
        const cat1Restant = Math.max(0, (record.small1Quantity || 0) - (record.small1Sold || 0));
        const cat2Restant = Math.max(0, (record.small2Quantity || 0) - (record.small2Sold || 0));
        const cat3Restant = Math.max(0, (record.medium1Quantity || 0) - (record.medium1Sold || 0));
        const cat4Restant = Math.max(0, (record.medium2Quantity || 0) - (record.medium2Sold || 0));
        const cat5Restant = Math.max(0, (record.large1Quantity || 0) - (record.large1Sold || 0));
        const cat6Restant = Math.max(0, (record.large2Quantity || 0) - (record.large2Sold || 0));
        const cat7Restant = Math.max(0, (record.xlarge1Quantity || 0) - (record.xlarge1Sold || 0));
        const cat8Restant = Math.max(0, (record.xlarge2Quantity || 0) - (record.xlarge2Sold || 0));
        
        // Valeur = (quantité restante × prix) pour chaque catégorie
        const valueRestant = (cat1Restant * (record.small1Price || 0)) +
                           (cat2Restant * (record.small2Price || 0)) +
                           (cat3Restant * (record.medium1Price || 0)) +
                           (cat4Restant * (record.medium2Price || 0)) +
                           (cat5Restant * (record.large1Price || 0)) +
                           (cat6Restant * (record.large2Price || 0)) +
                           (cat7Restant * (record.xlarge1Price || 0)) +
                           (cat8Restant * (record.xlarge2Price || 0));
        
        totalValue += valueRestant;
        
        // 5. CHIFFRE D'AFFAIRES (valeur des poulets VENDUS)
        totalRevenue += (record.small1Sold || 0) * (record.small1Price || 0) +
                       (record.small2Sold || 0) * (record.small2Price || 0) +
                       (record.medium1Sold || 0) * (record.medium1Price || 0) +
                       (record.medium2Sold || 0) * (record.medium2Price || 0) +
                       (record.large1Sold || 0) * (record.large1Price || 0) +
                       (record.large2Sold || 0) * (record.large2Price || 0) +
                       (record.xlarge1Sold || 0) * (record.xlarge1Price || 0) +
                       (record.xlarge2Sold || 0) * (record.xlarge2Price || 0);
    });
    
    // Période couverte
    const startDates = records.map(r => new Date(r.startDate));
    const earliestDate = startDates.length > 0 ? new Date(Math.min(...startDates)) : null;
    const latestDate = startDates.length > 0 ? new Date(Math.max(...startDates)) : null;
    
    let periodCovered = 'N/A';
    if (earliestDate && latestDate) {
        periodCovered = `${formatDate(earliestDate.toISOString())} - ${formatDate(latestDate.toISOString())}`;
    }
    
    return {
        totalRecords: records.length,
        totalProduction: Math.max(0, totalProduction),      // = 70
        totalStock: Math.round(totalStock),                 // = 100
        totalValue: Math.round(totalValue),                 // = 255 000
        totalRevenue: Math.round(totalRevenue),             // = 20 000
        periodCovered
    };
}

function calculateDetailedStatistics(records) {
    let totalSold = 0;
    let cat1Sold = 0, cat2Sold = 0, cat3Sold = 0, cat4Sold = 0;
    let cat5Sold = 0, cat6Sold = 0, cat7Sold = 0, cat8Sold = 0;
    let totalGiven = 0;
    let totalLost = 0;
    let totalNewChickens = 0;
    let totalInitialStock = 0;
    
    records.forEach(record => {
        cat1Sold += record.small1Sold || 0;
        cat2Sold += record.small2Sold || 0;
        cat3Sold += record.medium1Sold || 0;
        cat4Sold += record.medium2Sold || 0;
        cat5Sold += record.large1Sold || 0;
        cat6Sold += record.large2Sold || 0;
        cat7Sold += record.xlarge1Sold || 0;
        cat8Sold += record.xlarge2Sold || 0;
        
        totalGiven += record.given || 0;
        totalLost += record.lost || 0;
        totalNewChickens += record.newChickens || 0;
        totalInitialStock += record.initialStock || 0;
    });
    
    totalSold = cat1Sold + cat2Sold + cat3Sold + cat4Sold + cat5Sold + cat6Sold + cat7Sold + cat8Sold;
    
    return {
        totalSold,
        cat1Sold, cat2Sold, cat3Sold, cat4Sold, cat5Sold, cat6Sold, cat7Sold, cat8Sold,
        percentCat1: totalSold > 0 ? (cat1Sold / totalSold) * 100 : 0,
        percentCat2: totalSold > 0 ? (cat2Sold / totalSold) * 100 : 0,
        percentCat3: totalSold > 0 ? (cat3Sold / totalSold) * 100 : 0,
        percentCat4: totalSold > 0 ? (cat4Sold / totalSold) * 100 : 0,
        percentCat5: totalSold > 0 ? (cat5Sold / totalSold) * 100 : 0,
        percentCat6: totalSold > 0 ? (cat6Sold / totalSold) * 100 : 0,
        percentCat7: totalSold > 0 ? (cat7Sold / totalSold) * 100 : 0,
        percentCat8: totalSold > 0 ? (cat8Sold / totalSold) * 100 : 0,
        totalGiven,
        totalLost,
        totalNewChickens,
        avgInitialStock: records.length > 0 ? totalInitialStock / records.length : 0
    };
}

