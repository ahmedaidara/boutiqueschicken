// Charger les dépenses
function loadExpenses() {
    // Déterminer la période (même que pour les stats)
    let startDate, endDate;
    const today = new Date();
    
    switch(currentStatsPeriod) {
        case 'month':
            startDate = new Date(today.getFullYear(), today.getMonth(), 1);
            endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            break;
        case 'last-month':
            startDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            endDate = new Date(today.getFullYear(), today.getMonth(), 0);
            break;
        case 'year':
            startDate = new Date(today.getFullYear(), 0, 1);
            endDate = new Date(today.getFullYear(), 11, 31);
            break;
        case 'custom':
            if (!currentStatsStartDate || !currentStatsEndDate) return;
            startDate = currentStatsStartDate;
            endDate = currentStatsEndDate;
            break;
        case 'all':
        default:
            startDate = null;
            endDate = null;
    }
    
    db.collection('expenses')
        .orderBy('date', 'desc')
        .get()
        .then(snapshot => {
            const tbody = document.getElementById('expensesTableBody');
            tbody.innerHTML = '';
            
            let totalExpenses = 0;
            let expensesCount = 0;
            
            snapshot.forEach(doc => {
                const expense = doc.data();
                const expenseDate = expense.date?.toDate ? expense.date.toDate() : new Date(expense.date);
                
                // Filtrer par période si nécessaire
                if (startDate && endDate) {
                    if (expenseDate < startDate || expenseDate > endDate) {
                        return; // Skip cette dépense
                    }
                }
                
                const dateStr = formatDate(expenseDate.toISOString());
                const natureLabels = {
                    'salaire': 'Salaire',
                    'nourriture': 'Nourriture',
                    'transport': 'Transport',
                    'electricite': 'Électricité',
                    'eau': 'Eau',
                    'maintenance': 'Maintenance',
                    'fourniture': 'Fournitures',
                    'autre': 'Autre'
                };
                
                totalExpenses += expense.amount || 0;
                expensesCount++;
                
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${dateStr}</td>
                    <td>
                        <span class="expense-badge" style="background: ${getExpenseColor(expense.nature)};">
                            ${natureLabels[expense.nature] || expense.nature}
                        </span>
                    </td>
                    <td>${expense.description || ''}</td>
                    <td style="font-weight: bold; color: var(--danger);">${(expense.amount || 0).toLocaleString('fr-FR')} F CFA</td>
                    <td>
                        <div class="action-buttons">
                            <button class="action-btn-small delete" onclick="deleteExpense('${doc.id}')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                `;
                
                tbody.appendChild(row);
            });
            
            // Mettre à jour les totaux
            document.getElementById('totalExpenses').textContent = totalExpenses.toLocaleString('fr-FR') + ' F CFA';
            document.getElementById('expensesCount').textContent = expensesCount;
            
            // Calculer le bénéfice net
            const revenueElement = document.getElementById('totalRevenueStats');
            const revenueText = revenueElement.textContent.replace(/\D/g, '');
            const totalRevenue = parseInt(revenueText) || 0;
            const netProfit = totalRevenue - totalExpenses;
            
            document.getElementById('netProfit').textContent = netProfit.toLocaleString('fr-FR') + ' F CFA';
            document.getElementById('netProfit').style.color = netProfit >= 0 ? 'var(--secondary)' : 'var(--danger)';
            
        }).catch(error => {
            console.error('Erreur chargement dépenses:', error);
        });
}

// Couleur selon la nature de la dépense
function getExpenseColor(nature) {
    const colors = {
        'salaire': '#ef4444',
        'nourriture': '#10b981',
        'transport': '#3b82f6',
        'electricite': '#f59e0b',
        'eau': '#06b6d4',
        'maintenance': '#8b5cf6',
        'fourniture': '#ec4899',
        'autre': '#64748b'
    };
    
    return colors[nature] || '#64748b';
}

// Sauvegarder une dépense
function saveExpense() {
    const date = document.getElementById('expenseDate').value;
    const nature = document.getElementById('expenseNature').value;
    const description = document.getElementById('expenseDescription').value.trim();
    const amount = parseInt(document.getElementById('expenseAmount').value) || 0;
    
    if (!date) {
        showMessage('Veuillez sélectionner une date', 'error');
        return;
    }
    
    if (!description) {
        showMessage('Veuillez saisir une description', 'error');
        return;
    }
    
    if (amount <= 0) {
        showMessage('Veuillez saisir un montant valide', 'error');
        return;
    }
    
    const expenseData = {
        date: new Date(date),
        nature: nature,
        description: description,
        amount: amount,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
    };
    
    db.collection('expenses').add(expenseData)
        .then(() => {
            showMessage('Dépense enregistrée!', 'success');
            resetExpenseForm();
            loadExpenses();
        })
        .catch(error => {
            console.error('Erreur:', error);
            showMessage('Erreur lors de l\'enregistrement', 'error');
        });
}

// Supprimer une dépense
function deleteExpense(expenseId) {
    if (confirm('Voulez-vous vraiment supprimer cette dépense ?')) {
        db.collection('expenses').doc(expenseId).delete()
            .then(() => {
                showMessage('Dépense supprimée', 'success');
                loadExpenses();
            })
            .catch(error => {
                console.error('Erreur:', error);
                showMessage('Erreur lors de la suppression', 'error');
            });
    }
}

