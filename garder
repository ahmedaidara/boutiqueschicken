// Sauvegarder les dépenses de production
async function saveProductionExpenses() {
    if (!currentProductionForExpenses) {
        showMessage('Veuillez d\'abord sélectionner une production', 'error');
        return;
    }
    
    const productionId = currentProductionForExpenses.id;
    const revenue = parseInt(document.getElementById('productionRevenue').value) || 0;
    const totalExpenses = expensesData.reduce((sum, exp) => sum + (exp.total || 0), 0);
    
    // Filtrer les dépenses vides
    const validExpenses = expensesData.filter(exp => 
        exp.name && exp.name.trim() !== '' && exp.total > 0
    );
    
    if (validExpenses.length === 0 && totalExpenses === 0) {
        showMessage('Veuillez ajouter au moins une dépense', 'error');
        return;
    }
    
    showMessage('Enregistrement en cours...', 'warning');
    
    try {
        const expenseData = {
            productionId: productionId,
            productionDate: currentProductionForExpenses.data.startDate,
            revenue: revenue,
            expenses: validExpenses.map(exp => ({
                name: exp.name,
                description: exp.description,
                quantity: exp.quantity,
                unitPrice: exp.unitPrice,
                total: exp.total
            })),
            totalExpenses: totalExpenses,
            netProfit: revenue - totalExpenses,
            createdAt: firebase.firestore.FieldValue.serverTimestamp(),
            updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        };
        
        // Vérifier si une dépense existe déjà pour cette production
        const existingQuery = await db.collection('production_expenses')
            .where('productionId', '==', productionId)
            .limit(1)
            .get();
        
        if (!existingQuery.empty) {
            // Mettre à jour l'existant
            const docId = existingQuery.docs[0].id;
            await db.collection('production_expenses').doc(docId).update(expenseData);
            console.log('Dépenses mises à jour:', docId);
        } else {
            // Créer nouveau
            const docRef = await db.collection('production_expenses').add(expenseData);
            console.log('Dépenses créées:', docRef.id);
        }
        
        showMessage('✅ Dépenses enregistrées avec succès!', 'success');
        
        // Recharger la liste existante
        loadExistingExpensesList();
        
        // Afficher le bouton imprimer
        document.getElementById('printExpensesBtn').style.display = 'inline-block';
        
    } catch (error) {
        console.error('Erreur sauvegarde:', error);
        showMessage('❌ Erreur lors de l\'enregistrement: ' + error.message, 'error');
    }
}

