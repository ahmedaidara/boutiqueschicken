    <style>
        :root {
             
            --primary: #3B82F6;
            --primary-dark: #1D4ED8;
            --secondary: #10B981;
            --danger: #EF4444;
            --warning: #F59E0B;
            --light-bg: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);
            --dark-text: #1E293B;
            --gray-text: #64748B;
            --light-gray: #F1F5F9;
            --white: #FFFFFF;
            
            
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            
            
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;
            --radius-full: 25px;
            
             --space-xs: 4px;
            --space-sm: 8px;
            --space-md: 16px;
            --space-lg: 24px;
            --space-xl: 32px;
            --space-2xl: 40px;
            
             --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: var(--font-family);
        }
        
        body {
            background: var(--light-bg);
            color: var(--dark-text);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
         header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow-sm);
            padding: var(--space-md) var(--space-lg);
            position: sticky;
            top: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            gap: var(--space-md);
        }
        
        .logo {
            width: 50px;
            height: 50px;
            border-radius: var(--radius-md);
            object-fit: cover;
        }
        
        .app-title {
            font-size: 1.5rem;
            font-weight: 700;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .nav-links {
            display: flex;
            gap: var(--space-md);
            align-items: center;
        }
        
        .nav-btn {
            background: transparent;
            border: none;
            padding: var(--space-sm) var(--space-md);
            border-radius: var(--radius-md);
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: var(--space-sm);
        }
        
        .nav-btn:hover {
            background: var(--light-gray);
        }
        
       .nav-btn:hover {
    background: rgba(0, 0, 0, 0.03) !important;  
}
        
         main {
            padding: var(--space-lg);
            max-width: 1400px;
            margin: 0 auto;
        }
        
         .login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: var(--space-lg);
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        }
        
        .login-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: var(--space-2xl);
            box-shadow: var(--card-shadow);
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        
        .login-title {
            font-size: 1.8rem;
            margin-bottom: var(--space-lg);
            color: var(--dark-text);
        }
        
        .code-input-container {
            display: flex;
            justify-content: center;
            gap: var(--space-md);
            margin-bottom: var(--space-xl);
        }
        
        .code-input {
            width: 60px;
            height: 70px;
            font-size: 2rem;
            text-align: center;
            border: 2px solid var(--light-gray);
            border-radius: var(--radius-md);
            transition: all 0.3s ease;
            font-weight: bold;
            letter-spacing: 5px;
        }
        
        .code-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
            outline: none;
        }
        
        .login-btn {
            background: linear-gradient(90deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            padding: var(--space-md) var(--space-xl);
            border-radius: var(--radius-lg);
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-sm);
            width: 100%;
        }
        
        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }
        
        .error-message {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            padding: var(--space-md);
            border-radius: var(--radius-md);
            margin-top: var(--space-md);
            display: none;
        }
        
         .dashboard-section {
            margin-bottom: var(--space-2xl);
        }
        
        .section-title {
            font-size: 1.5rem;
            margin-bottom: var(--space-lg);
            display: flex;
            align-items: center;
            gap: var(--space-sm);
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: var(--space-lg);
            margin-bottom: var(--space-xl);
        }
        
        .stat-card {
            background: var(--white);
            border-radius: var(--radius-lg);
            padding: var(--space-xl);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
            border-top: 4px solid var(--primary);
            position: relative;
            overflow: hidden;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--card-shadow);
        }
        
        .stat-card:nth-child(2) {
            border-top-color: var(--secondary);
        }
        
        .stat-card:nth-child(3) {
            border-top-color: var(--warning);
        }
        
        .stat-card:nth-child(4) {
            border-top-color: #8B5CF6;
        }
        
        .stat-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(29, 78, 216, 0.1));
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: var(--space-md);
            color: var(--primary);
            font-size: 1.5rem;
        }
        
        .stat-card:nth-child(2) .stat-icon {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.1));
            color: var(--secondary);
        }
        
        .stat-card:nth-child(3) .stat-icon {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.1));
            color: var(--warning);
        }
        
        .stat-card:nth-child(4) .stat-icon {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(124, 58, 237, 0.1));
            color: #8B5CF6;
        }
        
        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: var(--space-xs);
        }
        
        .stat-label {
            color: var(--gray-text);
            font-size: 0.9rem;
        }
        
         .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: var(--space-lg);
        }
        
        .action-btn {
            background: var(--white);
            border: none;
            padding: var(--space-xl);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: var(--space-md);
        }
        
        .action-btn:hover {
            transform: translateY(-3px);
            box-shadow: var(--card-shadow);
        }
        
        .action-btn.primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
        }
        
        .action-btn.secondary {
            background: linear-gradient(135deg, var(--secondary), #059669);
            color: white;
        }
        
        .action-icon {
            font-size: 2rem;
        }
        
         .table-container {
            background: var(--white);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            margin-bottom: var(--space-2xl);
        }
        
        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-lg);
            border-bottom: 1px solid var(--light-gray);
            flex-wrap: wrap;
            gap: var(--space-md);
        }
        
        .filters {
            display: flex;
            gap: var(--space-sm);
            flex-wrap: wrap;
        }
        
        .filter-btn {
            padding: var(--space-sm) var(--space-md);
            border: 1px solid var(--light-gray);
            background: var(--white);
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .filter-btn:hover, .filter-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }
        
        .search-container {
            position: relative;
            min-width: 250px;
        }
        
        .search-input {
            width: 100%;
            padding: var(--space-sm) var(--space-md) var(--space-sm) 40px;
            border: 1px solid var(--light-gray);
            border-radius: var(--radius-md);
            font-size: 0.95rem;
        }
        
        .search-icon {
            position: absolute;
            left: var(--space-md);
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-text);
        }
        
        .table-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        
        .records-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1000px;
        }
        
        .records-table th {
            background: var(--light-gray);
            padding: var(--space-md);
            text-align: left;
            font-weight: 600;
            color: var(--dark-text);
            border-bottom: 1px solid #ddd;
        }
        
        .records-table td {
            padding: var(--space-md);
            border-bottom: 1px solid var(--light-gray);
        }
        
        .records-table tbody tr:hover {
            background: rgba(59, 130, 246, 0.05);
        }
        
        .action-buttons {
            display: flex;
            gap: var(--space-sm);
            flex-wrap: wrap;
        }
        
        .action-btn-small {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-md);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        
        .action-btn-small.view {
            background: rgba(59, 130, 246, 0.1);
            color: var(--primary);
        }
        
        .action-btn-small.update {
            background: rgba(16, 185, 129, 0.1);
            color: var(--secondary);
        }
        
        .action-btn-small.edit {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }
        
        .action-btn-small.delete {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }
        
        .action-btn-small:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }
        
        .empty-state {
            text-align: center;
            padding: var(--space-2xl);
            color: var(--gray-text);
        }
        
         .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: var(--space-md);
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        
        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        .modal {
            background: var(--white);
            border-radius: var(--radius-xl);
            padding: var(--space-2xl);
            box-shadow: var(--card-shadow);
            width: 100%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            transform: scale(0.9);
            transition: transform 0.3s ease;
        }
        
        .modal-overlay.active .modal {
            transform: scale(1);
        }
        
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-xl);
        }
        
        .modal-title {
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: var(--space-sm);
        }
        
        .close-modal {
            background: transparent;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--gray-text);
            width: 40px;
            height: 40px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .close-modal:hover {
            background: var(--light-gray);
        }
        
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: var(--space-lg);
            margin-bottom: var(--space-xl);
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
            gap: var(--space-sm);
        }
        
        .form-label {
            font-weight: 500;
            color: var(--dark-text);
        }
        
        .form-input {
            padding: var(--space-md);
            border: 1px solid var(--light-gray);
            border-radius: var(--radius-md);
            font-size: 1rem;
            transition: all 0.3s ease;
        }
        
        .form-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
            outline: none;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-lg);
        }
        
        .price-categories {
            background: var(--light-gray);
            padding: var(--space-lg);
            border-radius: var(--radius-lg);
            margin-bottom: var(--space-xl);
        }
        
        .price-category {
            background: var(--white);
            padding: var(--space-lg);
            border-radius: var(--radius-md);
            margin-bottom: var(--space-lg);
        }
        
        .price-category:last-child {
            margin-bottom: 0;
        }
        
        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: var(--space-md);
            margin-top: var(--space-xl);
        }
        
        .btn {
            padding: var(--space-md) var(--space-xl);
            border-radius: var(--radius-md);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            display: flex;
            align-items: center;
            gap: var(--space-sm);
        }
        
        .btn-secondary {
            background: var(--light-gray);
            color: var(--dark-text);
        }
        
        .btn-primary {
            background: linear-gradient(90deg, var(--primary), var(--primary-dark));
            color: white;
        }
        
        .btn-danger {
            background: linear-gradient(90deg, var(--danger), #DC2626);
            color: white;
        }
        
        .btn-success {
            background: linear-gradient(90deg, var(--secondary), #059669);
            color: white;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }
        
         .pdf-options {
            margin-bottom: var(--space-xl);
        }
        
        .option-group {
            background: var(--light-gray);
            padding: var(--space-lg);
            border-radius: var(--radius-lg);
            margin-bottom: var(--space-lg);
        }
        
        .option-item {
            display: flex;
            align-items: center;
            gap: var(--space-md);
            margin-bottom: var(--space-md);
        }
        
        .option-item:last-child {
            margin-bottom: 0;
        }
        
        .checkbox {
            width: 20px;
            height: 20px;
            accent-color: var(--primary);
        }
        
         .message {
            position: fixed;
            top: var(--space-lg);
            right: var(--space-lg);
            padding: var(--space-md) var(--space-xl);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            z-index: 1001;
            display: flex;
            align-items: center;
            gap: var(--space-md);
            transform: translateX(400px);
            transition: transform 0.3s ease;
        }
        
        .message.show {
            transform: translateX(0);
        }
        
        .message.success {
            background: var(--secondary);
            color: white;
        }
        
        .message.error {
            background: var(--danger);
            color: white;
        }
        
        .message.warning {
            background: var(--warning);
            color: white;
        }
        
         footer {
            text-align: center;
            padding: var(--space-lg);
            color: var(--gray-text);
            border-top: 1px solid var(--light-gray);
            margin-top: var(--space-xl);
        }
        
    @media (max-width: 768px) {
    header {
        display: grid;
        grid-template-columns: 50px 1fr;
        grid-template-areas: "logo nav";
        padding: 10px;
        gap: 10px;
        align-items: center;
    }
    
    .logo-container {
        grid-area: logo;
        width: 100%;
    }
    
    .logo {
        width: 40px;
        height: 40px;
    }
    
    .app-title {
        display: none;
    }
    
    .nav-links {
        grid-area: nav;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        overflow-x: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }
    
    .nav-links::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }
    
    .nav-btn {
        flex-shrink: 0;
        width: 45px;
        height: 45px;
        padding: 0;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 0;
    }
    
    .nav-btn i {
        font-size: 1rem;
    }
    
    .nav-btn span {
        font-size: 0.6rem;
        margin-top: 2px;
    }
}
        
      @media (max-width: 480px) {
    header {
        padding: 10px 12px;
        gap: 8px;
    }
    
    .logo-container {
        min-width: 40px; /* Juste pour le logo */
    }
    
    .logo {
        width: 32px;
        height: 32px;
    }
    
    .nav-links {
        gap: 4px;
    }
    
    .nav-btn {
        padding: 4px 6px;
        min-width: 48px;
        height: 36px;
        border-radius: 8px;
    }
    
    .nav-btn i {
        font-size: 0.8rem;
    }
    
    /* Option: cacher complètement le texte */
    .nav-btn span {
        display: none;
    }
}
        @media (max-width: 480px) {
            .nav-links {
                flex-direction: column;
                width: 100%;
            }
            
            .nav-btn {
                width: 100%;
                justify-content: center;
            }
            
            .code-input {
                width: 50px;
                height: 60px;
                font-size: 1.5rem;
            }
            
            .login-card {
                padding: var(--space-lg);
            }
        }
 
      #customPeriodSelector {
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

 .option-group {
    transition: all 0.3s ease;
}

.option-group:hover {
    box-shadow: var(--shadow-sm);
}

 select.form-input {
